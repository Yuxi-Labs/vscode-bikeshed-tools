{
  "Metadata Block": {
    "prefix": "meta",
    "body": [
      "<pre class='metadata'>",
      "Title: ${1:Your Spec Title}",
      "Shortname: ${2:your-spec}",
      "Level: ${3:1}",
      "Status: ${4:w3c/UD}",
      "URL: ${5:https://example.com/your-spec.html}",
      "Editor: ${6:Your Name}, ${7:Your Org}, ${8:you@example.com}",
      "Abstract: ${9:A brief description of the spec.}",
      "</pre>"
    ],
    "description": "Insert a metadata block"
  },
  "Section Header": {
    "prefix": "section",
    "body": [
      "${1:Section Title} {#${2:id}}",
      "====================",
      "",
      "$0"
    ],
    "description": "Insert a section header with ID"
  }
}
