{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*(\\*|//).*$",
      "action": {
        "indentAction": "none",
        "appendText": "// "
      }
    },
    {
      "beforeText": "^\\s*\\[\\[note\\]\\]:",
      "action": {
        "indentAction": "indent"
      }
    }
  ],
  "wordPattern": "[^\\s{}()[\\]\"']+"
}
