{
  "name": "vscode-bikeshed-tools",
  "displayName": "Bikeshed Tools",
  "description": "An extension that adds support for developing Bikeshed specs in Visual Studio Code",
  "version": "0.0.2",
  "publisher": "yuxi-labs",
  "enableProposedApi": false,

  "repository": {
    "type": "git",
    "url": "https://github.com/Yuxi-Labs/vscode-bikeshed-tools"
  },
  "bugs": {
    "url": "https://github.com/Yuxi-Labs/vscode-bikeshed-tools/issues"
  },
  "homepage": "https://www.yuxilabs.com/vscode-bikeshed-tools",
  "icon": "assets/images/icons/bikeshed-tools-icon.png",
  "galleryBanner": { "color": "#5e3b5b", "theme": "dark" },

  "engines": { "vscode": "^1.90.0", "node": ">=18.0.0" },
  "categories": ["Programming Languages"],
  "keywords": [
    "bikeshed", "spec", "editor", "language support",
    "W3C", "WHATWG", "markup", "syntax highlighting"
  ],

  "activationEvents": [
    "onLanguage:bikeshed",
    "onCommand:bikeshedTools.buildSpec",
    "onCommand:bikeshedTools.previewSpec",
    "onCommand:bikeshedTools.selectPython",
    "onCommand:bikeshedTools.selectBikeshed"
  ],

  "main": "./dist/extension.js",

  "contributes": {
    "snippets": [
      { "language": "bikeshed", "path": "./resources/snippets/bikeshed.json" }
    ],
    "grammars": [
      {
        "language": "bikeshed",
        "scopeName": "source.bikeshed",
        "path": "./resources/syntaxes/bikeshed.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.idl":  "webidl",
          "meta.embedded.block.cddl": "cddl",
          "meta.embedded.block.css":  "css"
        }
      }
    ],
    "languages": [
      {
        "id": "bikeshed",
        "aliases": ["Bikeshed", "bikeshed"],
        "extensions": [".bs"],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      { "command": "bikeshedTools.buildSpec",    "title": "Bikeshed: Build Spec" },
      { "command": "bikeshedTools.previewSpec",  "title": "Bikeshed: Preview Spec" },
      { "command": "bikeshedTools.selectPython", "title": "Bikeshed: Select Python Interpreter" },
      { "command": "bikeshedTools.selectBikeshed","title": "Bikeshed: Select Bikeshed CLI" }
    ],
    "menus": {
      "editor/title": [
        { "command": "bikeshedTools.previewSpec", "when": "resourceExtname == .bs", "group": "navigation" }
      ],
      "editor/context": [
        { "command": "bikeshedTools.buildSpec", "when": "resourceExtname == .bs", "group": "navigation" }
      ]
    },
    "configuration": {
      "title": "Bikeshed Tools",
      "properties": {
        "bikeshedTools.bikeshedPath": {
          "type": "string",
          "default": "",
          "description": "Explicit path to the Bikeshed CLI (optional – auto‑detected if empty)."
        },
        "bikeshedTools.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Explicit Python interpreter (optional – auto‑detected if empty)."
        },
        "bikeshedTools.livePreview": {
          "type": "boolean",
          "default": true,
          "description": "Enable live preview panel updates while editing Bikeshed documents."
        }
      }
    }
  },

  "scripts": {
    "publish": "npm run build && npx vsce package -o ./OUTPUT",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "build": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "format": "prettier --write ."
  },

  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/tmp": "^0.2.6",
    "@types/vscode": "^1.90.0",
    "@types/which": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "typescript": "^5.8.3",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },

  "dependencies": {
    "glob": "^11.0.3",
    "tmp": "^0.2.3",
    "which": "^5.0.0"
  },

  "publishConfig": { "registry": "https://registry.npmjs.org/" },
  "extensionKind": ["workspace"]
}
